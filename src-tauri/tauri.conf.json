{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "图片下载器",
  "version": "0.1.1",
  "identifier": "com.wj.imagedownloader",
  "build": {
    "beforeDevCommand": "py -m http.server 5173 --directory ../src",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": null,
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "图片下载器",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
